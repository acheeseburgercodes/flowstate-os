# Generate a random token, never commit the real .env file.
FLOWSTATE_API_TOKEN=
# PostgreSQL is the intended shared backend. SQLite supports local development.
FLOWSTATE_DATABASE_URL=sqlite:///./flowstate.db
# Separate custom agent for the FlowState bridge; do not reuse a controller-managed Codex agent.
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_ROOM_ID=
